<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Privacy manifest — Apple บังคับตั้งแต่ พ.ค. 2024

	NSPrivacyAccessedAPITypes คือส่วนที่ "บล็อกการอัปโหลด" ถ้าไม่มี: แอปนี้ใช้
	UserDefaults 13 ไฟล์ (cursor แชท, cache ความคืบหน้า, คิว feedback ที่ยังไม่ได้ส่ง)
	ซึ่งอยู่ในรายการ required-reason API ถ้าไม่ประกาศ App Store Connect จะตีกลับตั้งแต่
	ตอน validate ยังไม่ทันเข้ารีวิวด้วยซ้ำ

	ตรวจแล้วว่าไม่ได้ใช้ API กลุ่มอื่นที่ต้องประกาศเลย — ไม่มี file timestamp,
	ไม่มี system boot time, ไม่มี disk space, ไม่มี active keyboard

	NSPrivacyCollectedDataTypes ต้องตรงกับ nutrition label ที่กรอกใน App Store Connect
	ถ้าสองที่ไม่ตรงกันคือปัญหา · ทุกอย่างในนี้เก็บเพื่อให้แอปทำงานได้เท่านั้น
	ไม่มีโฆษณา ไม่มี tracking ไม่มีการขายต่อ
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- CA92.1 = เข้าถึงเฉพาะข้อมูลที่แอปตัวเองเขียนไว้ ไม่ได้อ่านของแอปอื่น -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!-- รหัสนักศึกษาที่ใช้ล็อกอิน -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- ชื่อที่แสดงในกลุ่มและในรายชื่อผู้เข้าร่วม -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- ข้อความแชทในกลุ่ม และข้อความความเห็นที่ให้คะแนนฐาน -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- FCM token ที่ส่งไปกับ /devices/register เพื่อให้ส่งแจ้งเตือนกลับมาถูกเครื่อง -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- พิกัดตอนกดขอความช่วยเหลือฉุกเฉิน (SOS) — ส่งให้เจ้าหน้าที่หาตัวเจอ -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePreciseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
